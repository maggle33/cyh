{
  "name": "课程与日程提醒",
  "short_name": "课程提醒",
  "description": "大学生课程表与日程提醒。数据保存在本机，可导出到手机系统日历，关掉应用也能准时提醒。",
  "lang": "zh-CN",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F4F4F2",
  "theme_color": "#185FA5",
  "id": "campus-reminder",
  "prefer_related_applications": false,
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "icons/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
